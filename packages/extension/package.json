{
  "name": "opencode-gui",
  "displayName": "opencode GUI",
  "description": "A rich GUI for opencode: chat with image & file attachments, file search, and slash commands — works across VS Code, Cursor, Windsurf, and VSCodium.",
  "version": "0.1.0",
  "publisher": "opencode-gui",
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": ["AI", "Chat", "Other"],
  "keywords": ["opencode", "ai", "chat", "agent", "assistant"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeGui",
          "title": "opencode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "opencodeGui": [
        {
          "type": "webview",
          "id": "opencodeGui.chat",
          "name": "opencode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodeGui.open",
        "title": "opencode: Open in Editor Tab"
      },
      {
        "command": "opencodeGui.newSession",
        "title": "opencode: New Session"
      },
      {
        "command": "opencodeGui.restartServer",
        "title": "opencode: Restart Server"
      }
    ],
    "configuration": {
      "title": "opencode GUI",
      "properties": {
        "opencode.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Connect to an already-running opencode server at this URL (e.g. http://localhost:4096). Leave empty to auto-spawn a managed server."
        },
        "opencode.binaryPath": {
          "type": "string",
          "default": "opencode",
          "description": "Path to the opencode executable used when auto-spawning the server."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies -o opencode-gui.vsix"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.3",
    "@opencode-gui/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
